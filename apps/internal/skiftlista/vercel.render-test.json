{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "SPIKE=1 npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/personal/:path*",
      "destination": "https://skiftlista-demo.onrender.com/:path*"
    },
    {
      "source": "/login",
      "destination": "https://skiftlista-demo.onrender.com/login"
    },
    {
      "source": "/login/:path*",
      "destination": "https://skiftlista-demo.onrender.com/login/:path*"
    },
    {
      "source": "/logout",
      "destination": "https://skiftlista-demo.onrender.com/logout"
    },
    {
      "source": "/static/:path*",
      "destination": "https://skiftlista-demo.onrender.com/static/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
